{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "web-dist",
  "functions": {
    "api/analyze.js": {
      "maxDuration": 120,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/report.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  }
}
