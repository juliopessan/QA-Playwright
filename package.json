{
  "name": "qa-agent",
  "version": "0.1.0",
  "description": "Agentic QA: Excel natural-language test cases -> Playwright execution -> HTML evidence report",
  "type": "module",
  "bin": {
    "qa-agent": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "qa-agent": "node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "demo": "vite-node scripts/demo.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "commander": "^12.1.0",
    "exceljs": "^4.4.0",
    "playwright": "1.56.1",
    "yaml": "^2.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "vite-node": "^3.2.4"
  }
}
